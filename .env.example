# Copy this file and fill in values before a local test run:
#   cp .env.example .env
#
# There are no API keys. Collection uses the flags and mode below.
# Postgres values must match docker-compose.yml unless you change both.

# --- App ---
PORT=3000
NODE_ENV=development

# --- Database ---
# Leave DB_SYNCHRONIZE=true for a local test so TypeORM can create tables.
# Optional alternative to the DB_* fields:
# DATABASE_URL=postgres://job_scraper:job_scraper@localhost:5432/job_scraper
DB_HOST=localhost
DB_PORT=5432
DB_NAME=job_scraper
DB_USER=job_scraper
DB_PASSWORD=job_scraper
DB_SYNCHRONIZE=true
DB_LOGGING=false

# --- Collection ---
# Enablement flags must be the string "true". Any other value is treated as off.
#
# Local pipeline test (reads fixtures/, no LinkedIn/XING HTTP):
#   COLLECTION_ENABLED=true
#   LINKEDIN_COLLECTION_ENABLED=true
#   XING_COLLECTION_ENABLED=true
#   COLLECTION_MODE=fixture
#
# Authorized live source run only:
#   COLLECTION_MODE=live
#   plus the matching source flag
COLLECTION_ENABLED=false
LINKEDIN_COLLECTION_ENABLED=false
XING_COLLECTION_ENABLED=false
COLLECTION_MODE=fixture
SOURCE_MAX_PAGES=1
SOURCE_REQUEST_TIMEOUT_MS=15000
# Use 0 for fixture tests; raise this for an authorized live run.
SOURCE_REQUEST_DELAY_MS=0
