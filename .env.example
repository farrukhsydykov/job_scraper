# Copy this file and fill in values before a local test run:
#   cp .env.example .env
#
# Collection is disabled by default; an authorized Apify token is required.
# Postgres values must match docker-compose.yml unless you change both.

# --- App ---
PORT=3000
NODE_ENV=development

# --- Database ---
# Run migrations before starting the app. Keep synchronization disabled.
# Optional alternative to the DB_* fields:
# DATABASE_URL=postgres://job_scraper:job_scraper@localhost:5432/job_scraper
DB_HOST=localhost
DB_PORT=5432
DB_NAME=job_scraper
DB_USER=job_scraper
DB_PASSWORD=job_scraper
DB_SYNCHRONIZE=false
DB_LOGGING=false

# --- Collection ---
# Apify is the only source provider. Collection is disabled unless all relevant
# gates are explicitly enabled. Keep the token out of source control.
COLLECTION_ENABLED=false
APIFY_TOKEN=
APIFY_LINKEDIN_ENABLED=false
APIFY_XING_ENABLED=false
APIFY_LINKEDIN_ACTOR_ID=worldunboxer/rapid-linkedin-scraper
APIFY_XING_ACTOR_ID=blackfalcondata/xing-scraper
APIFY_LINKEDIN_MAX_RESULTS=10
APIFY_XING_MAX_RESULTS=10
APIFY_ACTOR_TIMEOUT_SECS=300
