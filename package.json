{
  "name": "job-scraper",
  "version": "1.0.0",
  "description": "MVP job collection dashboard",
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -r src/views dist/views && cp -r public dist/public",
    "start": "NODE_ENV=production node dist/main",
    "start:dev": "NODE_ENV=development tsx watch src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farrukhsydykov/job_scraper.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/farrukhsydykov/job_scraper/issues"
  },
  "homepage": "https://github.com/farrukhsydykov/job_scraper#readme",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/typeorm": "^11.0.3",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ejs": "^6.0.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
